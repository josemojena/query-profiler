generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "sqlite"
}

model User {
  id       Int     @id @default(autoincrement())
  email    String  @unique
  password String?
  orders   Order[]
}

model Order {
  id     Int    @id @default(autoincrement())
  userId Int
  total  Int
  status String
  user   User   @relation(fields: [userId], references: [id])
}
