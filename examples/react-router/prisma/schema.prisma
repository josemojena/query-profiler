generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int    @id @default(autoincrement())
  email String @unique
  name  String @default("")
  posts Post[]
}

// No index on authorId on purpose: PostgreSQL does not create one for a foreign key, and the
// profiler says so. (published) is the start of (published, createdAt): the profiler flags it.
model Post {
  id        Int      @id @default(autoincrement())
  title     String
  published Boolean  @default(false)
  views     Int      @default(0)
  createdAt DateTime @default(now())
  authorId  Int
  author    User     @relation(fields: [authorId], references: [id])

  @@index([published])
  @@index([published, createdAt])
}

model Product {
  id        Int        @id @default(autoincrement())
  name      String
  price     Int
  offers    Offer[]
  purchases Purchase[]
}

model Offer {
  id        Int     @id @default(autoincrement())
  productId Int
  discount  Int
  product   Product @relation(fields: [productId], references: [id])
}

model Purchase {
  id        Int      @id @default(autoincrement())
  productId Int
  quantity  Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
}
