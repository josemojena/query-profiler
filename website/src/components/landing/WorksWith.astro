---
import { integrations } from "../../data/integrations";
import { link } from "../../data/site";
import Logo from "./Logo.astro";

// The landing page lists only what works today; the compatibility page also shows what is coming.
const supported = integrations.filter((integration) => integration.status === "ready");
---

<section class="wrap works">
  <div class="eyebrow">-- works with</div>
  <h2 class="title">Prisma first. Your framework next.</h2>
  <div class="panel result">
    <div class="query">
      <span class="k">SELECT</span> logo, name, versions <span class="k">FROM</span> integrations{" "}
      <span class="k">WHERE</span> status = <span class="s">'ready'</span>;
    </div>
    <ul class="rows">
      {
        supported.map((integration) => (
          <li>
            <Logo icon={integration.logo} name={integration.name} />
            {integration.guide ? (
              <a class="name" href={link(integration.guide)}>{integration.name}</a>
            ) : (
              <span class="name">{integration.name}</span>
            )}
            <span class="versions">{integration.versions ?? "—"}</span>
          </li>
        ))
      }
    </ul>
    <div class="count">({supported.length} rows)</div>
  </div>
</section>

<style>
  .works { padding-block: 0 80px; }
  .result { margin-top: 24px; overflow: hidden; font: 14px var(--mono); }
  .query { padding: 14px 18px; border-bottom: 1px solid var(--line); color: var(--muted); overflow-x: auto; white-space: nowrap; }
  .s { color: var(--string); }
  /* Two columns of rows, so a longer list stays short; one column on a phone. */
  .rows { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .rows li { display: flex; align-items: center; gap: 12px; min-width: 0; padding: 10px 18px; border-bottom: 1px solid #1c2130; }
  .rows li:nth-child(odd) { border-right: 1px solid #1c2130; }
  .name { color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .versions { margin-left: auto; padding-left: 12px; color: var(--dim); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .count { padding: 10px 18px; color: var(--dim); font-size: 13px; }
  @media (max-width: 560px) {
    .rows { grid-template-columns: 1fr; }
    .rows li:nth-child(odd) { border-right: 0; }
  }
</style>
