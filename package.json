{
  "name": "query-profiler",
  "version": "0.3.0",
  "description": "The database profiler for Prisma ORM, in development: every operation and SQL statement of a request, the line of code behind it, N+1, slow and duplicate warnings, in a bar on your pages.",
  "keywords": [
    "database",
    "debugbar",
    "devtools",
    "express",
    "fastify",
    "hapi",
    "hono",
    "koa",
    "n+1",
    "nestjs",
    "node",
    "orm",
    "pg",
    "postgres",
    "postgresql",
    "prisma",
    "prisma-client",
    "prisma-orm",
    "profiler",
    "query",
    "react-router",
    "remix",
    "slow queries",
    "sql",
    "vite"
  ],
  "homepage": "https://query-profiler.dev",
  "bugs": "https://github.com/josemojena/query-profiler/issues",
  "license": "MIT",
  "author": "Jose Mojena",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josemojena/query-profiler.git"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/node/register.js",
    "./dist/ui/index.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./constants": {
      "types": "./dist/core/constants.d.ts",
      "default": "./dist/core/constants.js"
    },
    "./register": {
      "types": "./dist/node/register.d.ts",
      "default": "./dist/node/register.js"
    },
    "./prisma": {
      "types": "./dist/prisma/index.d.ts",
      "development": "./dist/prisma/index.js",
      "default": "./dist/prisma/noop.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepare": "npm run build",
    "check-types": "tsc --noEmit && pnpm examples:sync && pnpm --filter './examples/*' typecheck",
    "test": "pnpm build && vitest run",
    "test:browser": "pnpm build && playwright test",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm format:check && pnpm check-types",
    "db:generate": "prisma generate --config test/prisma/fixture/prisma.config.ts && prisma generate --config test/prisma/fixture-mysql/prisma.config.ts && prisma generate --config test/prisma/fixture-sqlite/prisma.config.ts",
    "example:react-router": "pnpm examples:sync && pnpm --filter example-react-router dev",
    "example:express": "pnpm examples:sync && pnpm --filter example-express dev",
    "example:fastify": "pnpm examples:sync && pnpm --filter example-fastify dev",
    "examples:sync": "pnpm build && pnpm install --offline",
    "website:dev": "pnpm build && pnpm --filter website dev",
    "website:build": "pnpm build && pnpm --filter website build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hapi/hapi": "21.4.11",
    "@hono/node-server": "2.1.5",
    "@koa/bodyparser": "6.1.0",
    "@koa/router": "15.7.0",
    "@modelcontextprotocol/client": "^2.4.0",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@playwright/test": "1.64.0",
    "@prisma/adapter-better-sqlite3": "7.10.1",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@types/express": "5.0.3",
    "@types/koa": "3.0.3",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.27.7",
    "express": "5.3.0",
    "fastify": "^5.12.7",
    "hono": "4.13.13",
    "koa": "3.2.1",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tsx": "4.23.15",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "@prisma/client": ">=7.1.0",
    "pg": "^8.11.0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.5.0"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "better-sqlite3",
      "esbuild",
      "prisma"
    ]
  }
}
