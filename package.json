{
  "name": "query-profiler",
  "version": "0.2.1",
  "description": "The database profiler for Prisma ORM, in development: every operation and SQL statement of a request, the line of code behind it, N+1, slow and duplicate warnings, in a bar on your pages.",
  "keywords": [
    "database",
    "debugbar",
    "devtools",
    "fastify",
    "n+1",
    "orm",
    "pg",
    "postgres",
    "postgresql",
    "prisma",
    "prisma-client",
    "prisma-orm",
    "profiler",
    "query",
    "react-router",
    "remix",
    "slow queries",
    "sql",
    "vite"
  ],
  "homepage": "https://query-profiler.dev",
  "bugs": "https://github.com/josemojena/query-profiler/issues",
  "license": "MIT",
  "author": "Jose Mojena",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/josemojena/query-profiler.git"
  },
  "files": [
    "dist",
    "src",
    "CHANGELOG.md"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/ui/index.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./constants": {
      "types": "./dist/core/constants.d.ts",
      "default": "./dist/core/constants.js"
    },
    "./prisma": {
      "types": "./dist/prisma/index.d.ts",
      "development": "./dist/prisma/index.js",
      "default": "./dist/prisma/noop.js"
    },
    "./fastify": {
      "types": "./dist/fastify/index.d.ts",
      "development": "./dist/fastify/index.js",
      "default": "./dist/fastify/noop.js"
    },
    "./next/register": {
      "types": "./dist/next/register.d.ts",
      "development": "./dist/next/register.js",
      "default": "./dist/next/register-noop.js"
    },
    "./react-router": {
      "types": "./dist/react-router/index.d.ts",
      "development": "./dist/react-router/index.js",
      "default": "./dist/react-router/noop.js"
    },
    "./react-router/toolbar": {
      "types": "./dist/react-router/toolbar.d.ts",
      "development": "./dist/react-router/toolbar.js",
      "default": "./dist/react-router/toolbar-noop.js"
    },
    "./react-router/route": {
      "types": "./dist/react-router/route.d.ts",
      "development": "./dist/react-router/route.js",
      "default": "./dist/react-router/route-noop.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepare": "npm run build",
    "check-types": "tsc --noEmit && pnpm examples:sync && pnpm --filter './examples/*' typecheck",
    "test": "pnpm build && vitest run",
    "test:browser": "playwright test",
    "lint": "oxlint --type-aware .",
    "lint:fix": "oxlint --type-aware --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "pnpm lint && pnpm format:check && pnpm check-types",
    "db:generate": "prisma generate --config test/prisma/fixture/prisma.config.ts",
    "example:react-router": "pnpm examples:sync && pnpm --filter example-react-router dev",
    "example:fastify": "pnpm examples:sync && pnpm --filter example-fastify dev",
    "examples:sync": "pnpm build && pnpm install --offline",
    "website:dev": "pnpm build && pnpm --filter website dev",
    "website:build": "pnpm build && pnpm --filter website build"
  },
  "dependencies": {
    "fastify-plugin": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@prisma/adapter-pg": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "@types/node": "^22.15.3",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.27.7",
    "fastify": "^5.12.7",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "pg": "^8.20.0",
    "prisma": "^7.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.4",
    "typescript": "^5.6.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "peerDependencies": {
    "@prisma/client": ">=7.1.0",
    "fastify": ">=4.26.0",
    "pg": "^8.11.0",
    "react": ">=18.0.0",
    "react-router": ">=7.9.0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-router": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  },
  "packageManager": "pnpm@10.23.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
